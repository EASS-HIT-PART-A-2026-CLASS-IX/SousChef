# ── AI provider ─────────────────────────────────────────────────────────────
# Which AI backend handles recipe extraction, enhancement, and suggestions.
# Choices:  gemini    (cloud, needs GEMINI_API_KEY)
#           ollama    (local, needs the Ollama daemon running)
#           llamacpp  (local, needs llama-server running)
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# Optional — override the Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# ── Ollama settings (only used when AI_PROVIDER=ollama) ─────────────────────
# When the backend runs inside Docker and Ollama runs on the host,
# use http://host.docker.internal:11434 instead of localhost.
OLLAMA_BASE_URL=http://localhost:11434
# Must be a vision-capable model if you want /recipes/from-text image uploads to work.
OLLAMA_MODEL=gemma4:26b
# Local generation can be slow; bump this if you get timeouts.
# OLLAMA_TIMEOUT=180

# ── llama.cpp settings (only used when AI_PROVIDER=llamacpp) ─────────────────
# Run: llama-server -m your-model.gguf --port 8080
# When the backend runs inside Docker and llama-server runs on the host,
# use http://host.docker.internal:8080 instead of localhost.
LLAMACPP_BASE_URL=http://localhost:8080
# Must be a vision-capable model (e.g. llava, gemma3) for image upload support.
# LLAMACPP_MAX_TOKENS=900
# LLAMACPP_TIMEOUT=180

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=8501

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Used to protect admin routes (e.g. DELETE /recipes/{id}).
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate one with:
#   cd backend && python -c "from app import auth; print(auth.hash_password('admin'))"
ADMIN_PASSWORD_HASH=

# ── Redis + async refresh worker ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REFRESH_CONCURRENCY=5
REFRESH_TTL=3600
# Seconds the worker sleeps between refresh cycles.
REFRESH_INTERVAL=300
